# Thin code layer on top of the cached dependency image (Dockerfile.api-deps).
# A normal API deploy only rebuilds this: copy the source, restart. ~30-60 s.
FROM soc-api-deps:latest
COPY . .
ENV NODE_ENV=production
WORKDIR /app/apps/api
EXPOSE 4000
CMD ["/app/node_modules/.bin/tsx", "src/server.ts"]

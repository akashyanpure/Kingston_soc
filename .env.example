# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://soc:CHANGE_ME@localhost:5432/soc
# API
API_PORT=4000
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
AUTH_MODE=local
# Local adapters
STORAGE_DIR=./data/storage
MAIL_DIR=./data/mail
# Web
WEB_PORT=5173
ADDRESS_PROVIDER=postcodes_io
# Address lookup: postcodes_io (free, no key) | os_places (needs OS_PLACES_API_KEY, council PSGA) | none
OS_PLACES_API_KEY=
